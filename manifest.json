{
  "manifest_version": 3,
  "name": "ytbin-downloader",
  "version": "1.0.0",
  "description": "meowish video downloader",

  "browser_specific_settings": {
    "gecko": {
      "id": "wtf@example.com",
      "strict_min_version": "121.0"
    }
  },

  "permissions": [
    "downloads",
    "storage"
  ],

  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.googlevideo.com/*",
    "*://*.ytimg.com/*"
  ],

  "background": {
    "service_worker": "assets/js/bg.js",
    "type": "module"
  },

  "action": {
    "default_popup": "popup.html",
    "default_icon": "assets/icons/48.png"
  },

  "options_ui": {
    "page": "opt.html",
    "open_in_tab": true
  },

  "icons": {
    "48": "assets/icons/48.png",
    "128": "assets/icons/128.png"
  },

"content_scripts": [
  {
    "matches": ["*://*.youtube.com/*"],
    "css": ["assets/css/youtube.css", "assets/css/panel.css"],
    "js": [
      "assets/js/lib/messaging.js",
      "assets/js/content/youtube.js"
    ],
    "run_at": "document_idle"
  }
]
}